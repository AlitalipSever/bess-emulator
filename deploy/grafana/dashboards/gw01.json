{
  "uid": "gw01",
  "title": "GW-01 overview",
  "tags": ["bess-emulator"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Site state of charge",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_site_soc_ratio",
          "legendFormat": "SoC"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "POI active power (positive = export)",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_poi_active_power_watts",
          "legendFormat": "POI"
        },
        {
          "refId": "B",
          "expr": "bess_site_setpoint_watts",
          "legendFormat": "setpoint"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Grid frequency",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": 49.9,
          "max": 50.1,
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_grid_frequency_hertz",
          "legendFormat": "f"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "POI energy meters",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_import_watthours_total",
          "legendFormat": "import"
        },
        {
          "refId": "B",
          "expr": "bess_export_watthours_total",
          "legendFormat": "export"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperatures: weather, container air, cells",
      "description": "The thermal chain M1 models, on one axis: what the weather does, what the container air does about it, and where the cells end up.",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 2, "fillOpacity": 0 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_ambient_celsius",
          "legendFormat": "ambient"
        },
        {
          "refId": "B",
          "expr": "bess_container_air_celsius_max",
          "legendFormat": "container air, hottest"
        },
        {
          "refId": "C",
          "expr": "bess_container_air_celsius_mean",
          "legendFormat": "container air, mean"
        },
        {
          "refId": "D",
          "expr": "bess_cell_celsius_max",
          "legendFormat": "cells, hottest"
        },
        {
          "refId": "E",
          "expr": "bess_cell_celsius_min",
          "legendFormat": "cells, coldest"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HVAC staging (containers per mode)",
      "description": "How many of the 40 containers are idle, running one cooling unit, running both, or heating.",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_hvac_containers",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "House load by item",
      "description": "The station load as an inventory rather than a number. The stack adds up to the auxiliary power the substation meters.",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_aux_power_watts",
          "legendFormat": "{{item}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Global horizontal irradiance",
      "description": "The replayed irradiance series driving envelope solar gain.",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "Wm2",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_irradiance_watts_per_square_meter",
          "legendFormat": "irradiance"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Where the energy went (cumulative)",
      "description": "Every category of energy that did not reach the point of interconnection, each metered on its own path. This is the loss waterfall the M1 gate asks for.",
      "datasource": { "type": "prometheus", "uid": "bess-prom" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bess_loss_watthours_total",
          "legendFormat": "{{category}}"
        }
      ]
    }
  ]
}
